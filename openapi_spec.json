{
  "openapi": "3.1.0",
  "info": {
    "title": "TPM 2.0 Measurement Quote Agent — Rule-based Demo API",
    "description": "Educational in-memory audit API. No hardware TPM quote parsing, signature verification, or TCG/NIST conformance checks are performed.",
    "version": "3.0.0-ENTERPRISE"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health and demo metadata",
        "responses": {
          "200": {
            "description": "Healthy service"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory JSON counters",
        "responses": {
          "200": {
            "description": "Task and audit log counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate numeric thresholds and descriptor keywords",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number",
                    "default": 0
                  },
                  "status_descriptor": {
                    "type": "string",
                    "default": "NOMINAL"
                  },
                  "is_critical_flag": {
                    "type": "boolean",
                    "default": false
                  },
                  "attributes": {
                    "type": "object"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration dossier (not a hardware attestation result)"
          },
          "400": {
            "description": "Potential identifier rejected"
          },
          "422": {
            "description": "Input validation error"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock chat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock chat response"
          },
          "400": {
            "description": "Potential identifier rejected"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Inspect and check the process-local audit chain",
        "responses": {
          "200": {
            "description": "In-memory HMAC audit entries and integrity flag"
          }
        }
      }
    }
  }
}
